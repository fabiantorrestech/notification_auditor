<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/permissionSetupFragment">

    <fragment
        android:id="@+id/permissionSetupFragment"
        android:name="com.example.notificationauditor.ui.onboarding.PermissionSetupFragment"
        android:label="Setup">
        <action
            android:id="@+id/action_setup_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/permissionSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.notificationauditor.ui.dashboard.DashboardFragment"
        android:label="Dashboard">
        <action
            android:id="@+id/action_dashboard_to_insights"
            app:destination="@id/insightsDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/insightsDashboardFragment"
        android:name="com.example.notificationauditor.ui.insights.InsightsDashboardFragment"
        android:label="Insights">
        <action
            android:id="@+id/action_insights_to_detail"
            app:destination="@id/insightDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/insightDetailFragment"
        android:name="com.example.notificationauditor.ui.insights.InsightDetailFragment"
        android:label="Insight Detail">
        <argument
            android:name="date"
            app:argType="string" />
    </fragment>

</navigation>
