<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_channel_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.7"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_channel_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:layout_marginTop="6dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_utility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tv_score_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:layout_marginTop="2dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested mute"
            android:layout_marginTop="6dp"
            app:chipBackgroundColor="?attr/colorErrorContainer"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
